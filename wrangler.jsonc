{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pnm-voting",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/photos/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "VotingRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VotingRoom"] }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "ballot-photos" }],
  "ratelimits": [
    { "name": "ROOM_CREATION_LIMIT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "ROOM_ACCESS_LIMIT", "namespace_id": "4102", "simple": { "limit": 1200, "period": 60 } },
  ],
  "observability": { "enabled": true },
}
